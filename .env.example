# Public REST API URL used by browser-safe code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional server-only REST API URL. Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:8000/api

# Backend auth endpoints.
AUTH_LOGIN_PATH=/auth/login
AUTH_REFRESH_PATH=/auth/refresh
AUTH_ME_PATH=/auth/me

# HTTP-only JWT cookie names.
AUTH_ACCESS_COOKIE=access_token
AUTH_REFRESH_COOKIE=refresh_token
